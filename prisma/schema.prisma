// Esquema de base de datos. Motor: PostgreSQL (Render Postgres, Neon, Supabase, etc).
// Después de editar este archivo, corre:
//   npx prisma generate       -> regenera el cliente TypeScript
//   npx prisma db push        -> aplica el esquema a la base de datos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String            @id @default(cuid())
  slug          String            @unique
  nombre        String
  referencia    String?
  descripcion   String
  precioBase    Int // COP, sin decimales
  imagen        String // URL http(s) o data URL (imagen subida desde el admin)
  imagenSecundaria String? // opcional: ej. una foto mostrando variantes de color
  categoriaSlug String
  destacado     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  variantes     ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  nombre    String // ej. "Grande", "Aroma Lavanda"
  precio    Int // COP
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum EstadoOrden {
  pendiente
  pagado
  fallido
}

model Order {
  id              String      @id @default(cuid())
  referencia      String      @unique // referencia enviada a Wompi / Mercado Pago
  metodo          String // "wompi" | "mercadopago"
  estado          EstadoOrden @default(pendiente)
  total           Int // COP
  nombreCliente   String?
  emailCliente    String?
  telefonoCliente String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productoSlug   String
  nombre         String
  varianteNombre String?
  precio         Int // COP, precio unitario al momento de la compra
  cantidad       Int
}
